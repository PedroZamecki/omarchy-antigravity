#!/usr/bin/python3
# omarchy:summary=Print the Antigravity usage record as JSON
# omarchy:args=[--force] [--limits-only] [--write]
# omarchy:hidden=true
"""Collect Google Antigravity usage into one display-ready JSON record.

Everything the agents panel shows for Antigravity comes from this one
command: local transcript stats from ~/.gemini/antigravity-cli/brain,
the summaries database and history fallbacks, and authoritative rate
limits from the Google Cloud Code backend. The panel itself only ever
reads the JSON this prints; it never talks to disk formats or endpoints.
"""

from __future__ import annotations

