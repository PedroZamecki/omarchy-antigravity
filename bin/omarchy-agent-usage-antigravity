#!/usr/bin/python3
# omarchy:summary=Print the Antigravity usage record as JSON
# omarchy:args=[--force] [--limits-only] [--write]
# omarchy:hidden=true
"""Collect Google Antigravity usage into one display-ready JSON record.

Everything the agents panel shows for Antigravity comes from this one
command: local transcript stats from ~/.gemini/antigravity-cli/brain,
conversations databases across ~/.gemini, the summaries database and
history fallbacks, and rate limits from agy's own `/quota` command.
The panel itself only ever reads the JSON this prints;
it never talks to disk formats or endpoints.
"""

from __future__ import annotations

import argparse
import datetime as dt
import fcntl
import hashlib
import json
import os
import re
import shutil
import sqlite3
import subprocess
import sys
import tempfile
import time
from pathlib import Path
from typing import Any

AGENT_ID = "antigravity"
AGENT_NAME = "Antigravity"
AUTH_HELP = "Run `agy` to sign in to Antigravity."

LIMITS_REUSE_SECONDS = 300
SCAN_REUSE_SECONDS = 20
LIMITS_ONLY_REUSE_SECONDS = 900

FALLBACK_TIER = "Antigravity"


def cache_root() -> Path:
    root = (
        Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
        / "omarchy"
        / "agent-usage"
    )
    root.mkdir(parents=True, exist_ok=True)
    return root


def usage_dir() -> Path:
    root = (
        Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state"))
        / "omarchy"
        / "agents"
        / "usage"
    )
    root.mkdir(parents=True, exist_ok=True)
    return root


def app_data_dir() -> Path:
    return Path(
        os.environ.get("ANTIGRAVITY_APP_DATA_DIR")
        or (Path.home() / ".gemini" / "antigravity-cli")
    )


def config_path() -> Path:
    return Path.home() / ".config" / "omarchy" / "agents" / "antigravity.json"


def provider_id() -> str:
    plugin_dir = Path(__file__).resolve().parents[1]
    svg_stem = plugin_dir / "assets" / "antigravity"
    # Omarchy Panel.qml resolves Qt.resolvedUrl("assets/" + p.providerId + ".svg")
    # relative to /usr/share/omarchy/shell/plugins/agents/.
    # Walking 7 levels up reaches filesystem root, allowing user assets to resolve
    # seamlessly without root permissions or modifying /usr/share/.
    return "../../../../../../../" + str(svg_stem).lstrip("/")


def local_date_string() -> str:
    return dt.datetime.now().astimezone().date().isoformat()


def recent_date_strings() -> list[str]:
    today = dt.datetime.now().astimezone().date()
    return [
        (today - dt.timedelta(days=offset)).isoformat() for offset in range(6, -1, -1)
    ]


def local_date_from_timestamp(value: Any) -> str:
    if value is None:
        return local_date_string()
    if isinstance(value, (int, float)):
        try:
            seconds = (
                float(value) / 1000.0 if float(value) > 10_000_000_000 else float(value)
            )
            return dt.datetime.fromtimestamp(seconds).astimezone().date().isoformat()
        except Exception:
            return local_date_string()
    raw = str(value).strip()
    if not raw:
        return local_date_string()
    try:
        parsed = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
        if parsed.tzinfo is not None:
            parsed = parsed.astimezone()
        return parsed.date().isoformat()
    except Exception:
        return local_date_string()


def number(value: Any) -> int:
    try:
        n = float(value or 0)
        return round(n) if n == n else 0
    except Exception:
        return 0


def empty_bucket() -> dict[str, int]:
    return {
        "inputTokens": 0,
        "outputTokens": 0,
        "cacheReadInputTokens": 0,
        "cacheCreationInputTokens": 0,
    }


def empty_stats() -> dict[str, Any]:
    recent_dates = recent_date_strings()
    return {
        "todayPrompts": 0,
        "todaySessions": 0,
        "todayTotalTokens": 0,
        "todayTokensByModel": {},
        "recentDays": [{"date": day, "messageCount": 0} for day in recent_dates],
        "totalPrompts": 0,
        "totalSessions": 0,
        "activeDays": 0,
        "activeDates": [],
        "modelUsage": {},
    }


def declared_plan() -> str:
    cfg_file = config_path()
    if not cfg_file.is_file():
        return ""
    try:
        cfg = json.loads(cfg_file.read_text(encoding="utf-8"))
        if isinstance(cfg, dict):
            tier = cfg.get("tierLabel") or cfg.get("plan") or cfg.get("tier")
            if isinstance(tier, str) and tier.strip():
                return tier.strip()
    except (OSError, ValueError):
        pass
    return ""


def read_fresh_json(path: Path, max_age_seconds: float) -> dict[str, Any] | None:
    if max_age_seconds <= 0 or not path.exists():
        return None
    try:
        age = time.time() - path.stat().st_mtime
        if 0 <= age <= max_age_seconds:
            return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None
    return None


def write_json(path: Path, payload: dict[str, Any]) -> None:
    handle_fd, tmp_name = tempfile.mkstemp(
        dir=path.parent, prefix=path.name + ".", suffix=".tmp"
    )
    tmp = Path(tmp_name)
    try:
        with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
            handle.write(
                json.dumps(payload, separators=(",", ":"), sort_keys=True) + "\n"
            )
        tmp.chmod(0o644)
        tmp.replace(path)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


def normalize_model_id(raw_name: str) -> str:
    if not raw_name:
        return "gemini-3.7-flash"
    s = raw_name.lower().strip()
    s = re.sub(r"\(.*?\)", "", s).strip()
    s = re.sub(r"-(control|high|low|default)$", "", s)
    s = re.sub(r"[^a-z0-9.]+", "-", s).strip("-")
    if (
        not s.startswith("gemini")
        and not s.startswith("claude")
        and not s.startswith("gpt")
    ):
        s = "gemini-" + s
    return s


def parse_db_datetime(value: str) -> dt.datetime | None:
    if not value:
        return None
    val = value.strip()
    try:
        when = dt.datetime.fromisoformat(val)
    except ValueError:
        try:
            when = dt.datetime.strptime(val, "%Y-%m-%d %H:%M:%S")
        except ValueError:
            return None
    if when.year < 2000:
        return None
    return when


def parse_proto_fields(data: bytes) -> list[tuple[int, int, Any]]:
    pos = 0
    fields = []
    length_data = len(data)
    while pos < length_data:
        tag = 0
        shift = 0
        while True:
            if pos >= length_data:
                return fields
            b = data[pos]
            pos += 1
            tag |= (b & 0x7F) << shift
            if not (b & 0x80):
                break
            shift += 7
            if shift > 64:
                return fields
        field_num = tag >> 3
        wire_type = tag & 0x7
        if wire_type == 0:  # varint
            val = 0
            shift = 0
            while True:
                if pos >= length_data:
                    break
                b = data[pos]
                pos += 1
                val |= (b & 0x7F) << shift
                if not (b & 0x80):
                    break
                shift += 7
                if shift > 64:
                    break
            fields.append((field_num, wire_type, val))
        elif wire_type == 1:  # 64-bit
            val = data[pos : pos + 8]
            pos += 8
            fields.append((field_num, wire_type, val))
        elif wire_type == 2:  # length-delimited
            length = 0
            shift = 0
            while True:
                if pos >= length_data:
                    break
                b = data[pos]
                pos += 1
                length |= (b & 0x7F) << shift
                if not (b & 0x80):
                    break
                shift += 7
                if shift > 64:
                    break
            if length < 0 or pos + length > length_data:
                break
            val = data[pos : pos + length]
            pos += length
            fields.append((field_num, wire_type, val))
        elif wire_type == 5:  # 32-bit
            val = data[pos : pos + 4]
            pos += 4
            fields.append((field_num, wire_type, val))
        else:
            break
    return fields


def candidate_app_dirs(primary_dir: Path) -> list[Path]:
    dirs = [
        primary_dir,
        Path.home() / ".gemini" / "antigravity-acp",
        Path.home() / ".gemini" / "antigravity",
        Path.home() / ".gemini" / "antigravity-cli",
    ]
    seen: set[str] = set()
    result = []
    for d in dirs:
        try:
            resolved = str(d.resolve())
        except Exception:
            resolved = str(d)
        if resolved not in seen and d.is_dir():
            seen.add(resolved)
            result.append(d)
    return result


# ---------------------------------------------------------------- local scan


def scan_local_usage(app_dir: Path) -> dict[str, Any]:
    stats = empty_stats()
    today_date = dt.datetime.now().astimezone().date()
    today_str = today_date.isoformat()
    window = [today_date - dt.timedelta(days=i) for i in range(6, -1, -1)]
    recent = {d.isoformat(): {"date": d.isoformat(), "messageCount": 0} for d in window}

    today_tokens_by_model: dict[str, int] = {}
    model_usage: dict[str, dict[str, int]] = {}
    today_sessions: set[str] = set()
    total_sessions: set[str] = set()
    active_dates: set[str] = set()
    total_prompts = 0
    today_prompts = 0
    today_total_tokens = 0

    seen_cids: set[str] = set()

    for search_dir in candidate_app_dirs(app_dir):
        # 1. Scan SQLite conversations (modern Antigravity and ACP)
        conv_dir = search_dir / "conversations"
        if conv_dir.is_dir():
            try:
                for db_path in conv_dir.glob("*.db"):
                    cid = db_path.stem
                    if cid in seen_cids:
                        continue
                    seen_cids.add(cid)
                    total_sessions.add(cid)

                    try:
                        conn = sqlite3.connect(
                            f"file:{db_path.resolve()}?mode=ro", uri=True, timeout=5
                        )
                        conn.execute("PRAGMA query_only = ON")
                        c = conn.cursor()

                        db_dates: set[str] = set()
                        step_timestamps: dict[int, int] = {}

                        # Step rows for prompts and dates
                        step_rows = c.execute(
                            "SELECT idx, step_type, metadata FROM steps"
                        ).fetchall()
                        for s_idx, s_type, s_meta in step_rows:
                            if s_type == 14:  # USER_INPUT
                                total_prompts += 1
                            if s_meta:
                                fields = parse_proto_fields(s_meta)
                                for fnum, wtype, val in fields:
                                    if fnum == 1 and wtype == 2:
                                        t_fields = parse_proto_fields(val)
                                        for tf, tw, tv in t_fields:
                                            if (
                                                tf == 1
                                                and tw == 0
                                                and tv > 1_000_000_000
                                            ):
                                                step_timestamps[s_idx] = tv
                                                s_dt = dt.datetime.fromtimestamp(
                                                    tv
                                                ).astimezone()
                                                s_date = s_dt.date().isoformat()
                                                db_dates.add(s_date)
                                                active_dates.add(s_date)
                                                if s_type == 14 and s_date == today_str:
                                                    today_prompts += 1

                        if today_str in db_dates:
                            today_sessions.add(cid)

                        # Generation metadata for tokens and models
                        gen_rows = c.execute(
                            "SELECT idx, data FROM gen_metadata"
                        ).fetchall()
                        for g_idx, g_data in gen_rows:
                            fields = parse_proto_fields(g_data)
                            for fnum, wtype, val in fields:
                                if fnum == 1 and wtype == 2:
                                    subfields = parse_proto_fields(val)
                                    model_name = "gemini-3.7-flash"
                                    tokens = {}
                                    ts_val = None
                                    last_step = None
                                    for sfnum, swtype, sval in subfields:
                                        if sfnum == 19 and swtype == 2:
                                            try:
                                                model_name = sval.decode(
                                                    "utf-8", errors="ignore"
                                                )
                                            except Exception:
                                                pass
                                        elif sfnum == 4 and swtype == 2:
                                            tf = parse_proto_fields(sval)
                                            tokens = {
                                                tfnum: tval
                                                for tfnum, tw, tval in tf
                                                if tw == 0
                                            }
                                        elif sfnum == 9 and swtype == 2:
                                            for tsf, tsw, tsval in parse_proto_fields(
                                                sval
                                            ):
                                                if tsf == 4 and tsw == 2:
                                                    for (
                                                        tf_n,
                                                        tf_w,
                                                        tf_v,
                                                    ) in parse_proto_fields(tsval):
                                                        if (
                                                            tf_n == 1
                                                            and tf_w == 0
                                                            and tf_v > 1_000_000_000
                                                        ):
                                                            ts_val = tf_v
                                        elif sfnum == 20 and swtype == 2:
                                            k, v = None, None
                                            for ssfn, sswt, ssval in parse_proto_fields(sval):
                                                if ssfn == 1 and sswt == 2:
                                                    k = ssval.decode("utf-8", errors="ignore")
                                                elif ssfn == 2 and sswt == 2:
                                                    v = ssval.decode("utf-8", errors="ignore")
                                            if k == "last_step_index" and v and v.isdigit():
                                                last_step = int(v)

                                    if not ts_val:
                                        if last_step is not None and last_step in step_timestamps:
                                            ts_val = step_timestamps[last_step]
                                        elif g_idx in step_timestamps:
                                            ts_val = step_timestamps[g_idx]
                                        elif step_timestamps:
                                            ts_val = step_timestamps[max(step_timestamps.keys())]
                                        else:
                                            try:
                                                ts_val = int(db_path.stat().st_mtime)
                                            except Exception:
                                                pass

                                    norm_model = normalize_model_id(model_name)
                                    in_tok = tokens.get(2, 0)
                                    out_tok = tokens.get(3, 0)
                                    cache_read = tokens.get(9, 0)
                                    cache_write = tokens.get(10, 0)
                                    turn_total = (
                                        in_tok + out_tok + cache_read + cache_write
                                    )

                                    bucket = model_usage.setdefault(
                                        norm_model, empty_bucket()
                                    )
                                    bucket["inputTokens"] += in_tok
                                    bucket["outputTokens"] += out_tok
                                    bucket["cacheReadInputTokens"] += cache_read
                                    bucket["cacheCreationInputTokens"] += cache_write

                                    if ts_val:
                                        turn_dt = dt.datetime.fromtimestamp(
                                            ts_val
                                        ).astimezone()
                                        turn_date = turn_dt.date().isoformat()
                                        if turn_date in recent:
                                            recent[turn_date]["messageCount"] += (
                                                turn_total
                                            )
                                        if turn_date == today_str:
                                            today_total_tokens += turn_total
                                            today_tokens_by_model[norm_model] = (
                                                today_tokens_by_model.get(norm_model, 0)
                                                + turn_total
                                            )
                        conn.close()
                    except Exception:
                        pass
            except Exception:
                pass

        # 2. Legacy transcript.jsonl scanner
        brain_dir = search_dir / "brain"
        if brain_dir.is_dir():
            try:
                for conv_dir in brain_dir.iterdir():
                    if not conv_dir.is_dir():
                        continue
                    conv_name = conv_dir.name
                    if conv_name in seen_cids:
                        continue
                    transcript_path = (
                        conv_dir / ".system_generated" / "logs" / "transcript.jsonl"
                    )
                    if not transcript_path.is_file():
                        transcript_path = conv_dir / "transcript.jsonl"
                    if not transcript_path.is_file():
                        continue

                    current_model = "gemini-3.7-flash"
                    try:
                        with transcript_path.open(
                            "r", encoding="utf-8", errors="replace"
                        ) as fh:
                            for line in fh:
                                line = line.strip()
                                if not line:
                                    continue
                                try:
                                    step = json.loads(line)
                                except Exception:
                                    continue

                                content = str(step.get("content", ""))
                                thinking = str(step.get("thinking", ""))
                                tool_calls = step.get("tool_calls")
                                created_at_str = step.get("created_at") or ""
                                step_type = step.get("type", "")

                                step_date_str = local_date_from_timestamp(
                                    created_at_str
                                )

                                if "Model Selection" in content:
                                    m = re.search(
                                        r"Model Selection\` from .*? to (.+?)\.\s*(?:No need|\Z)",
                                        content,
                                    )
                                    if m:
                                        current_model = normalize_model_id(m.group(1))

                                input_tokens = 0
                                output_tokens = 0

                                if step_type == "USER_INPUT":
                                    total_prompts += 1
                                    input_tokens += max(1, len(content) // 4)
                                    if step_date_str == today_str:
                                        today_prompts += 1
                                elif step_type in ("PLANNER_RESPONSE", "GENERIC"):
                                    output_tokens += len(content) // 4
                                    if thinking:
                                        output_tokens += len(thinking) // 4
                                    if tool_calls:
                                        try:
                                            output_tokens += (
                                                len(json.dumps(tool_calls)) // 4
                                            )
                                        except Exception:
                                            pass
                                elif step_type == "CHECKPOINT":
                                    input_tokens += len(content) // 4

                                total_step_tokens = input_tokens + output_tokens
                                if total_step_tokens > 0 or step_type == "USER_INPUT":
                                    active_dates.add(step_date_str)
                                    total_sessions.add(conv_name)

                                    bucket = model_usage.setdefault(
                                        current_model, empty_bucket()
                                    )
                                    bucket["inputTokens"] += input_tokens
                                    bucket["outputTokens"] += output_tokens

                                    if step_date_str in recent:
                                        recent[step_date_str]["messageCount"] += (
                                            total_step_tokens
                                        )

                                    if step_date_str == today_str:
                                        today_sessions.add(conv_name)
                                        today_total_tokens += total_step_tokens
                                        today_tokens_by_model[current_model] = (
                                            today_tokens_by_model.get(current_model, 0)
                                            + total_step_tokens
                                        )
                    except Exception:
                        pass
            except Exception:
                pass

        # 3. Read conversation summaries database for any additional sessions
        summaries_db = search_dir / "conversation_summaries.db"
        if summaries_db.is_file():
            try:
                conn = sqlite3.connect(
                    "file:" + str(summaries_db.resolve()) + "?mode=ro",
                    uri=True,
                    timeout=5,
                )
                conn.execute("PRAGMA query_only = ON")
                rows = conn.execute(
                    "SELECT conversation_id, last_user_input_time, last_modified_time FROM conversation_summaries"
                ).fetchall()
                conn.close()
                for cid, luit, lmt in rows:
                    when = parse_db_datetime(str(luit or "")) or parse_db_datetime(
                        str(lmt or "")
                    )
                    if when is None:
                        continue
                    day_str = when.date().isoformat()
                    active_dates.add(day_str)
                    total_sessions.add(cid or str(when))
                    if day_str == today_str and cid:
                        today_sessions.add(cid)
            except Exception:
                pass

        # 4. Read history.jsonl for prompt history fallback
        history_file = search_dir / "history.jsonl"
        if history_file.is_file():
            try:
                with history_file.open("r", encoding="utf-8", errors="replace") as fh:
                    for line in fh:
                        line = line.strip()
                        if not line:
                            continue
                        try:
                            item = json.loads(line)
                            ts = item.get("timestamp")
                            if ts:
                                day_str = local_date_from_timestamp(ts)
                                active_dates.add(day_str)
                        except Exception:
                            pass
            except Exception:
                pass

    stats["totalSessions"] = len(total_sessions)
    stats["todaySessions"] = len(today_sessions)
    stats["totalPrompts"] = total_prompts
    stats["todayPrompts"] = today_prompts
    stats["todayTotalTokens"] = today_total_tokens
    stats["todayTokensByModel"] = today_tokens_by_model
    stats["modelUsage"] = model_usage
    stats["activeDates"] = sorted(active_dates)
    stats["activeDays"] = len(active_dates)
    stats["recentDays"] = [recent[d.isoformat()] for d in window]

    return stats


def scan_cache_paths(app_dir: Path) -> tuple[Path, Path]:
    digest = hashlib.sha1(str(app_dir).encode("utf-8")).hexdigest()[:16]
    root = cache_root()
    return (
        root / f"antigravity-scan-{digest}.json",
        root / f"antigravity-scan-{digest}.lock",
    )


def cached_scan(app_dir: Path, max_age_seconds: float) -> dict[str, Any]:
    cache_file, lock_file = scan_cache_paths(app_dir)
    today = local_date_string()

    cached = read_fresh_json(cache_file, max_age_seconds)
    if (
        cached is not None
        and isinstance(cached.get("stats"), dict)
        and cached.get("scanDate") == today
    ):
        return cached["stats"]

    with lock_file.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        cached = read_fresh_json(cache_file, max_age_seconds)
        if (
            cached is not None
            and isinstance(cached.get("stats"), dict)
            and cached.get("scanDate") == today
        ):
            return cached["stats"]
        summary = scan_local_usage(app_dir)
        write_json(cache_file, {"stats": summary, "scanDate": today})
        return summary


# ---------------------------------------------------------------- auth & limits


def format_bucket_title(group_name: str, bucket: dict[str, Any]) -> str:
    gn = (group_name or "").strip()
    raw_window = str(bucket.get("window", "")).strip().lower()

    if "5h" in raw_window or "session" in raw_window or "hour" in raw_window:
        window = "Session"
    elif "week" in raw_window:
        window = "Weekly"
    elif "month" in raw_window:
        window = "Monthly"
    elif "day" in raw_window:
        window = "Daily"
    elif raw_window:
        window = raw_window.capitalize()
    else:
        window = ""

    if gn.lower() == "claude and gpt models":
        base = "Claude & GPT"
    elif gn.lower() == "gemini models":
        base = "Gemini"
    else:
        base = re.sub(r"\s+models\b", "", gn, flags=re.IGNORECASE).strip() or gn

    if window:
        return f"{base} {window}"
    return base or "Limit"



def bucket_sort_key(bucket: dict[str, Any]) -> int:
    raw_window = str(bucket.get("window", "")).strip().lower()
    raw_id = str(bucket.get("id", "")).strip().lower()
    raw_name = str(bucket.get("name", "")).strip().lower()
    combined = f"{raw_window} {raw_id} {raw_name}"
    if "5h" in combined or "session" in combined or "hour" in combined:
        return 0
    if "day" in combined or "daily" in combined:
        return 1
    if "week" in combined:
        return 2
    if "month" in combined:
        return 3
    return 4


def limit_window_rank(entry: dict[str, Any]) -> int:
    text = (str(entry.get("title", "")) + " " + str(entry.get("label", ""))).lower()
    if "session" in text or "5h" in text or "hour" in text:
        return 0
    if "daily" in text or "day" in text:
        return 1
    if "weekly" in text or "week" in text:
        return 2
    if "monthly" in text or "month" in text:
        return 3
    return 4


def sort_limits(limits: list[dict[str, Any]]) -> list[dict[str, Any]]:
    if not isinstance(limits, list):
        return []
    # Preserve family/model group order while placing session before weekly within each group
    groups: dict[str, list[dict[str, Any]]] = {}
    for entry in limits:
        if not isinstance(entry, dict):
            continue
        text = str(entry.get("title") or entry.get("label") or "").strip()
        group_key = re.sub(
            r"(\s+|^)(session|weekly|daily|monthly|hour|day|week|month)\b.*$",
            "",
            text,
            flags=re.IGNORECASE,
        ).strip().lower()
        groups.setdefault(group_key, []).append(entry)

    sorted_limits: list[dict[str, Any]] = []
    for entry_list in groups.values():
        sorted_limits.extend(sorted(entry_list, key=limit_window_rank))
    return sorted_limits

def parse_quota_limits(quota_summary: dict[str, Any] | None) -> list[dict[str, Any]]:
    if not quota_summary or not isinstance(quota_summary, dict):
        return []

    if "command" in quota_summary and isinstance(quota_summary["command"], dict):
        cmd_data = quota_summary["command"].get("data")
        if isinstance(cmd_data, dict):
            quota_summary = cmd_data

    limits = []
    groups = quota_summary.get("groups", [])
    if isinstance(groups, list):
        for group in groups:
            if not isinstance(group, dict):
                continue
            group_name = group.get("displayName") or group.get("name") or ""
            raw_buckets = group.get("buckets", [])
            buckets = (
                sorted(raw_buckets, key=bucket_sort_key)
                if isinstance(raw_buckets, list)
                else []
            )
            for bucket in buckets:
                if not isinstance(bucket, dict):
                    continue
                rem_frac = bucket.get("remainingFraction")
                if rem_frac is None:
                    rem_frac = bucket.get("remaining_fraction")
                if rem_frac is None:
                    continue
                try:
                    rem_frac = float(rem_frac)
                except (ValueError, TypeError):
                    continue

                used_pct = max(0.0, min(1.0, 1.0 - rem_frac))
                # When no quota has been consumed yet (0% used / 100% remaining), the window has
                # not started ticking down, so suppress the placeholder reset timestamp.
                # Once the user begins consuming quota (> 0% used), the authoritative reset timestamp is shown.
                reset_raw = bucket.get("resetTime") or bucket.get("reset_time") or ""
                reset_time = str(reset_raw) if used_pct > 0.0 else ""
                title = format_bucket_title(group_name, bucket)
                label = (
                    bucket.get("displayName")
                    or bucket.get("name")
                    or f"{title} Limit Remaining"
                )

                limits.append(
                    {
                        "title": title,
                        "label": label,
                        "percent": round(used_pct, 4),
                        "resetsAt": reset_time,
                    }
                )
    return sort_limits(limits)


def find_antigravity_binary() -> str | None:
    # The shell's PATH may not carry mise shims, so fall back to mise's install dir.
    for name in ("agy", "antigravity"):
        binary = shutil.which(name)
        if binary:
            return binary
    fallback = (
        Path.home()
        / ".local/share/mise/installs/aqua-google-antigravity-antigravity-cli/latest/antigravity"
    )
    if fallback.is_file() and os.access(fallback, os.X_OK):
        return str(fallback)
    return None


def probe_antigravity_cli() -> list[dict[str, Any]]:
    # agy owns its sign-in: asking it for /quota (no model turn) keeps OAuth
    # tokens and client credentials out of this plugin entirely.
    binary = find_antigravity_binary()
    if not binary:
        return []
    try:
        proc = subprocess.run(
            [binary, "-p", "/quota", "--output-format", "json"],
            capture_output=True,
            text=True,
            timeout=20,
        )
        if proc.returncode == 0 and proc.stdout.strip():
            return parse_quota_limits(json.loads(proc.stdout))
    except (OSError, subprocess.TimeoutExpired, ValueError):
        pass
    return []



def limit_window_open(entry: dict[str, Any], now: dt.datetime) -> bool:
    raw = str(entry.get("resetsAt") or "").strip()
    if not raw:
        return True
    try:
        resets_at = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
    except Exception:
        return True
    if resets_at.tzinfo is None:
        resets_at = resets_at.replace(tzinfo=dt.timezone.utc)
    return resets_at > now


def usable_cached_limits(cached: dict[str, Any]) -> list[dict[str, Any]]:
    entries = cached.get("limits")
    if not isinstance(entries, list):
        return []
    now = dt.datetime.now(dt.timezone.utc)
    return sort_limits(
        [
            entry
            for entry in entries
            if isinstance(entry, dict) and limit_window_open(entry, now)
        ]
    )


def collect_limits(force: bool) -> dict[str, Any]:
    probe_cache = cache_root() / "antigravity-limits.json"
    cached = read_fresh_json(probe_cache, float("inf")) or {}

    # agy takes a few seconds per call, so live limits are fetched at most every
    # LIMITS_REUSE_SECONDS. Failed attempts are cached too, so a signed-out agy
    # is not re-run on every refresh.
    fetched_at = number(cached.get("fetchedAtMs")) / 1000.0
    if force or time.time() - fetched_at >= LIMITS_REUSE_SECONDS:
        probed = probe_antigravity_cli()
        cached = {
            "fetchedAtMs": round(time.time() * 1000),
            "ok": bool(probed),
            "limits": probed or cached.get("limits") or [],
        }
        write_json(probe_cache, cached)

    result = {
        "limits": usable_cached_limits(cached),
        "tierLabel": declared_plan() or FALLBACK_TIER,
        "usageStatusText": "",
        "authHelpText": "",
    }
    if not result["limits"] and cached.get("ok") is False:
        result["usageStatusText"] = "Antigravity limits unavailable"
        result["authHelpText"] = AUTH_HELP
    return result


# -------------------------------------------------------------------- record


def write_record(record: dict[str, Any]) -> None:
    target_dir = usage_dir()
    record_path = target_dir / f"{AGENT_ID}.json"
    handle_fd, tmp_name = tempfile.mkstemp(
        dir=target_dir, prefix=f".{AGENT_ID}.", suffix=".tmp"
    )
    tmp = Path(tmp_name)
    try:
        with os.fdopen(handle_fd, "w", encoding="utf-8") as fh:
            json.dump(record, fh, separators=(",", ":"), sort_keys=True)
            fh.write("\n")
        tmp.chmod(0o644)
        tmp.replace(record_path)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Print the Antigravity usage record as JSON"
    )
    parser.add_argument(
        "--force",
        action="store_true",
        help="rescan transcripts and re-probe limits, ignoring caches",
    )
    parser.add_argument(
        "--limits-only",
        action="store_true",
        help="reuse any recent transcript scan; only the limits probe must be fresh",
    )
    parser.add_argument("--cache-seconds", type=float, default=SCAN_REUSE_SECONDS)
    parser.add_argument(
        "--write",
        action="store_true",
        help="also write the record to agents usage state directory",
    )
    args = parser.parse_args()

    app_dir = app_data_dir()
    scan_age = (
        0
        if args.force
        else (LIMITS_ONLY_REUSE_SECONDS if args.limits_only else args.cache_seconds)
    )
    stats = cached_scan(app_dir, scan_age)
    limits = collect_limits(args.force)

    record = {
        "schemaVersion": 1,
        "id": provider_id(),
        "name": AGENT_NAME,
        "icon": "\ue908",
        "iconFont": "omarchy-antigravity",
        "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
        "ready": (
            number(stats.get("totalPrompts")) > 0
            or len(limits["limits"]) > 0
            or number(stats.get("totalSessions")) > 0
            or number(stats.get("activeDays")) > 0
        ),
        "hasLocalStats": (
            number(stats.get("totalPrompts")) > 0
            or number(stats.get("totalSessions")) > 0
            or number(stats.get("activeDays")) > 0
        ),
        "scope": "account",
        "hasPromptStats": number(stats.get("totalPrompts")) > 0,
        "tierLabel": limits["tierLabel"],
        "usageStatusText": limits["usageStatusText"],
        "authHelpText": limits["authHelpText"],
        "limits": sort_limits(limits["limits"]),
    }
    record.update(stats)

    output = json.dumps(record, separators=(",", ":"), sort_keys=True)
    if args.write or not sys.stdout.isatty():
        # When invoked by update scripts or background services, always ensure state file is written
        write_record(record)
    print(output)
    return 0


if __name__ == "__main__":
    sys.exit(main())
