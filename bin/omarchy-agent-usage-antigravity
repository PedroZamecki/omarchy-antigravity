FALLBACK_TIER = "Antigravity"


def cache_root() -> Path:
    root = Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache")) / "omarchy" / "agent-usage"
    root.mkdir(parents=True, exist_ok=True)
    return root


def usage_dir() -> Path:
    root = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state")) / "omarchy" / "agents" / "usage"
    root.mkdir(parents=True, exist_ok=True)
    return root


def app_data_dir() -> Path:
    return Path(os.environ.get("ANTIGRAVITY_APP_DATA_DIR") or (Path.home() / ".gemini" / "antigravity-cli"))


def config_path() -> Path:
    return Path.home() / ".config" / "omarchy" / "agents" / "antigravity.json"


def local_date_string() -> str:
    return dt.datetime.now().astimezone().date().isoformat()


def recent_date_strings() -> list[str]:
    today = dt.datetime.now().astimezone().date()
    return [(today - dt.timedelta(days=offset)).isoformat() for offset in range(6, -1, -1)]


def local_date_from_timestamp(value: Any) -> str:
    if value is None:
        return local_date_string()
    if isinstance(value, (int, float)):
        try:
            seconds = float(value) / 1000.0 if float(value) > 10_000_000_000 else float(value)
            return dt.datetime.fromtimestamp(seconds).astimezone().date().isoformat()
        except Exception:
            return local_date_string()
    raw = str(value).strip()
    if not raw:
        return local_date_string()
    try:
        parsed = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
        if parsed.tzinfo is not None:
            parsed = parsed.astimezone()
        return parsed.date().isoformat()
    except Exception:
        return local_date_string()


def number(value: Any) -> int:
    try:
        n = float(value or 0)
        return round(n) if n == n else 0
    except Exception:
        return 0


def empty_bucket() -> dict[str, int]:
    return {
        "inputTokens": 0,
        "outputTokens": 0,
        "cacheReadInputTokens": 0,
        "cacheCreationInputTokens": 0,
    }


def empty_stats() -> dict[str, Any]:
    recent_dates = recent_date_strings()
    return {
        "todayPrompts": 0,
        "todaySessions": 0,
        "todayTotalTokens": 0,
        "todayTokensByModel": {},
        "recentDays": [{"date": day, "messageCount": 0} for day in recent_dates],
        "totalPrompts": 0,
        "totalSessions": 0,
        "activeDays": 0,
        "activeDates": [],
        "modelUsage": {},
    }


def declared_plan() -> str:
    cfg_file = config_path()
    if not cfg_file.is_file():
        return ""
    try:
        cfg = json.loads(cfg_file.read_text(encoding="utf-8"))
        if isinstance(cfg, dict):
            tier = cfg.get("tierLabel") or cfg.get("plan") or cfg.get("tier")
            if isinstance(tier, str) and tier.strip():
                return tier.strip()
    except (OSError, ValueError):
        pass
    return ""


def read_fresh_json(path: Path, max_age_seconds: float) -> dict[str, Any] | None:
    if max_age_seconds <= 0 or not path.exists():
        return None
    try:
        age = time.time() - path.stat().st_mtime
        if 0 <= age <= max_age_seconds:
            return json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return None
    return None


def write_json(path: Path, payload: dict[str, Any]) -> None:
    handle_fd, tmp_name = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
    tmp = Path(tmp_name)
    try:
        with os.fdopen(handle_fd, "w", encoding="utf-8") as handle:
            handle.write(json.dumps(payload, separators=(",", ":"), sort_keys=True) + "\n")
        tmp.chmod(0o644)
        tmp.replace(path)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


def normalize_model_id(raw_name: str) -> str:
    if not raw_name:
        return "gemini-3.7-flash"
    s = raw_name.lower().strip()
    s = re.sub(r"\(.*?\)", "", s).strip()
    s = re.sub(r"[^a-z0-9.]+", "-", s).strip("-")
    if not s.startswith("gemini") and not s.startswith("claude") and not s.startswith("gpt"):
        s = "gemini-" + s
    return s


def parse_db_datetime(value: str) -> dt.datetime | None:
    if not value:
        return None
    val = value.strip()
    try:
        when = dt.datetime.fromisoformat(val)
    except ValueError:
        try:
            when = dt.datetime.strptime(val, "%Y-%m-%d %H:%M:%S")
        except ValueError:
            return None
    if when.year < 2000:
        return None
    return when


# ---------------------------------------------------------------- local scan


def scan_local_usage(app_dir: Path) -> dict[str, Any]:
    stats = empty_stats()
    today_date = dt.datetime.now().astimezone().date()
    today_str = today_date.isoformat()
    window = [today_date - dt.timedelta(days=i) for i in range(6, -1, -1)]
    recent = {d.isoformat(): {"date": d.isoformat(), "messageCount": 0} for d in window}

    today_tokens_by_model: dict[str, int] = {}
    model_usage: dict[str, dict[str, int]] = {}
    today_sessions: set[str] = set()
    total_sessions: set[str] = set()
    active_dates: set[str] = set()
    total_prompts = 0
    today_prompts = 0
    today_total_tokens = 0

    # 1. Scan conversation transcripts
    brain_dir = app_dir / "brain"
    if brain_dir.is_dir():
        try:
            for conv_dir in brain_dir.iterdir():
                if not conv_dir.is_dir():
                    continue
                conv_name = conv_dir.name
                transcript_path = conv_dir / ".system_generated" / "logs" / "transcript.jsonl"
                if not transcript_path.is_file():
                    transcript_path = conv_dir / "transcript.jsonl"
                if not transcript_path.is_file():
                    continue

                current_model = "gemini-3.7-flash"
                try:
                    with transcript_path.open("r", encoding="utf-8", errors="replace") as fh:
                        for line in fh:
                            line = line.strip()
                            if not line:
                                continue
                            try:
                                step = json.loads(line)
                            except Exception:
                                continue

                            content = str(step.get("content", ""))
                            thinking = str(step.get("thinking", ""))
                            tool_calls = step.get("tool_calls")
                            created_at_str = step.get("created_at") or ""
                            step_type = step.get("type", "")

                            step_date_str = local_date_from_timestamp(created_at_str)

                            if "Model Selection" in content:
                                m = re.search(r"Model Selection\` from .*? to (.+?)\.\s*(?:No need|\Z)", content)
                                if m:
                                    current_model = normalize_model_id(m.group(1))

                            input_tokens = 0
                            output_tokens = 0

                            if step_type == "USER_INPUT":
                                total_prompts += 1
                                input_tokens += max(1, len(content) // 4)
                                if step_date_str == today_str:
                                    today_prompts += 1
                            elif step_type in ("PLANNER_RESPONSE", "GENERIC"):
                                output_tokens += len(content) // 4
                                if thinking:
                                    output_tokens += len(thinking) // 4
                                if tool_calls:
                                    try:
                                        output_tokens += len(json.dumps(tool_calls)) // 4
                                    except Exception:
                                        pass
                            elif step_type == "CHECKPOINT":
                                input_tokens += len(content) // 4

                            total_step_tokens = input_tokens + output_tokens
                            if total_step_tokens > 0 or step_type == "USER_INPUT":
                                active_dates.add(step_date_str)
                                total_sessions.add(conv_name)

                                bucket = model_usage.setdefault(current_model, empty_bucket())
                                bucket["inputTokens"] += input_tokens
                                bucket["outputTokens"] += output_tokens

                                if step_date_str in recent:
                                    recent[step_date_str]["messageCount"] += total_step_tokens

                                if step_date_str == today_str:
                                    today_sessions.add(conv_name)
                                    today_total_tokens += total_step_tokens
                                    today_tokens_by_model[current_model] = (
                                        today_tokens_by_model.get(current_model, 0) + total_step_tokens
                                    )
                except Exception:
                    pass
        except Exception:
            pass

    # 2. Read conversation summaries database for any additional sessions
    summaries_db = app_dir / "conversation_summaries.db"
    if summaries_db.is_file():
        try:
            conn = sqlite3.connect("file:" + str(summaries_db.resolve()) + "?mode=ro", uri=True, timeout=5)
            conn.execute("PRAGMA query_only = ON")
            rows = conn.execute(
                "SELECT conversation_id, last_user_input_time, last_modified_time FROM conversation_summaries"
            ).fetchall()
            conn.close()
            for cid, luit, lmt in rows:
                when = parse_db_datetime(str(luit or "")) or parse_db_datetime(str(lmt or ""))
                if when is None:
                    continue
                day_str = when.date().isoformat()
                active_dates.add(day_str)
                total_sessions.add(cid or str(when))
                if day_str == today_str and cid:
                    today_sessions.add(cid)
        except Exception:
            pass

    # 3. Read history.jsonl for prompt history fallback
    history_file = app_dir / "history.jsonl"
    if history_file.is_file():
        try:
            with history_file.open("r", encoding="utf-8", errors="replace") as fh:
                for line in fh:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        item = json.loads(line)
                        ts = item.get("timestamp")
                        if ts:
                            day_str = local_date_from_timestamp(ts)
                            active_dates.add(day_str)
                    except Exception:
                        pass
        except Exception:
            pass

    stats["totalSessions"] = len(total_sessions)
    stats["todaySessions"] = len(today_sessions)
    stats["totalPrompts"] = total_prompts
    stats["todayPrompts"] = today_prompts
    stats["todayTotalTokens"] = today_total_tokens
    stats["todayTokensByModel"] = today_tokens_by_model
    stats["modelUsage"] = model_usage
    stats["activeDates"] = sorted(active_dates)
    stats["activeDays"] = len(active_dates)
    stats["recentDays"] = [recent[d.isoformat()] for d in window]

    return stats


def scan_cache_paths(app_dir: Path) -> tuple[Path, Path]:
    digest = hashlib.sha1(str(app_dir).encode("utf-8")).hexdigest()[:16]
    root = cache_root()
    return root / f"antigravity-scan-{digest}.json", root / f"antigravity-scan-{digest}.lock"


def cached_scan(app_dir: Path, max_age_seconds: float) -> dict[str, Any]:
    cache_file, lock_file = scan_cache_paths(app_dir)

    cached = read_fresh_json(cache_file, max_age_seconds)
    if cached is not None and isinstance(cached.get("stats"), dict):
        return cached["stats"]

    with lock_file.open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        cached = read_fresh_json(cache_file, max_age_seconds)
        if cached is not None and isinstance(cached.get("stats"), dict):
            return cached["stats"]
        summary = scan_local_usage(app_dir)
        write_json(cache_file, {"stats": summary, "scanDate": local_date_string()})
        return summary


# ---------------------------------------------------------------- auth & limits


def read_keyring_token() -> tuple[dict[str, Any] | None, str]:
    """Reads stored OAuth token JSON from secret-tool."""
    try:
        out = subprocess.run(
            ["secret-tool", "lookup", "service", KEYRING_TOKEN_SERVICE, "username", KEYRING_TOKEN_USERNAME],
            capture_output=True,
            text=True,
            timeout=10,
        )
    except FileNotFoundError:
        return None, "no_secret_tool"
    except (OSError, subprocess.TimeoutExpired):
        return None, "secret_tool_error"

    if out.returncode != 0 or not out.stdout.strip():
        return None, "empty"

    try:
        data = json.loads(out.stdout)
    except ValueError:
        return None, "invalid_json"

    token = data.get("token")
    if not isinstance(token, dict):
        return None, "no_token_dict"

    return token, "ok"


def token_is_valid(token: dict[str, Any]) -> bool:
    expiry_str = token.get("expiry")
    if not isinstance(expiry_str, str):
        return True
    try:
        expiry_dt = dt.datetime.fromisoformat(expiry_str)
        # 60s buffer to prevent edge-of-expiry race conditions
        return expiry_dt > (dt.datetime.now().astimezone() + dt.timedelta(seconds=60))
    except ValueError:
        return True


class RefreshResult:
    def __init__(self, access_token: str | None, error_type: str = "", error_code: int = 0):
        self.access_token = access_token
        # error_type: "invalid_grant", "transport", "http_error", ""
        self.error_type = error_type
        self.error_code = error_code


def refresh_oauth_token(refresh_token: str) -> RefreshResult:
    if not refresh_token:
        return RefreshResult(None, error_type="invalid_grant")

    last_error_type = "invalid_grant"
    last_error_code = 0

    for client_id, client_secret in OAUTH_CLIENTS:
        payload = urllib.parse.urlencode({
            "client_id": client_id,
            "client_secret": client_secret,
            "refresh_token": refresh_token,
            "grant_type": "refresh_token",
        }).encode("utf-8")
        req = urllib.request.Request(
            OAUTH_TOKEN_URL,
            data=payload,
            headers={"Content-Type": "application/x-www-form-urlencoded"},
            method="POST",
        )
        try:
            with urllib.request.urlopen(req, timeout=10) as resp:
                data = json.loads(resp.read().decode("utf-8"))
                new_token = data.get("access_token")
                if new_token:
                    return RefreshResult(new_token)
        except urllib.error.HTTPError as err:
            last_error_code = err.code
            try:
                body = json.loads(err.read().decode("utf-8", errors="replace"))
                err_str = str(body.get("error") or "")
                if "invalid_grant" in err_str or "unauthorized_client" in err_str:
                    last_error_type = "invalid_grant"
                else:
                    last_error_type = "http_error"
            except Exception:
                last_error_type = "http_error"
        except (urllib.error.URLError, TimeoutError, OSError):
            last_error_type = "transport"

    return RefreshResult(None, error_type=last_error_type, error_code=last_error_code)


class BackendResult:
    def __init__(
        self,
        ok: bool,
        tier_label: str = "",
        project_id: str = "",
        limits: list[dict[str, Any]] | None = None,
        error_type: str = "",  # "unauthenticated", "rate_limited", "transport", "http_error"
        http_code: int = 0,
        help_text: str = "",
        retry_after: str = "",
    ):
        self.ok = ok
        self.tier_label = tier_label
        self.project_id = project_id
        self.limits = limits or []
        self.error_type = error_type
        self.http_code = http_code
        self.help_text = help_text
        self.retry_after = retry_after


def post_json(url: str, payload_dict: dict[str, Any], access_token: str, timeout: int = 8) -> tuple[dict[str, Any] | None, BackendResult | None]:
    payload_bytes = json.dumps(payload_dict).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=payload_bytes,
        headers={
            "Authorization": f"Bearer {access_token}",
            "Content-Type": "application/json",
            "User-Agent": "antigravity-cli",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = json.loads(resp.read().decode("utf-8", errors="replace"))
            return data, None
    except urllib.error.HTTPError as error:
        retry_after = error.headers.get("retry-after", "") if error.headers else ""
        if error.code in (401, 403):
            return None, BackendResult(ok=False, error_type="unauthenticated", http_code=error.code)
        if error.code == 429:
            return None, BackendResult(ok=False, error_type="rate_limited", http_code=error.code, retry_after=retry_after)
        return None, BackendResult(
            ok=False,
            error_type="http_error",
            http_code=error.code,
            help_text=f"Google Cloud Code backend returned status {error.code}. Local Antigravity stats are still shown.",
        )
    except Exception:
        return None, BackendResult(
            ok=False,
            error_type="transport",
            help_text="Couldn't reach Google Cloud Code backend. Retrying shortly. Local Antigravity stats are still shown.",
        )


def format_bucket_title(group_name: str, bucket: dict[str, Any]) -> str:
    gn = (group_name or "").strip()
    raw_window = str(bucket.get("window", "")).strip().lower()

    if "5h" in raw_window or "session" in raw_window or "hour" in raw_window:
        window = "Session"
    elif "week" in raw_window:
        window = "Weekly"
    elif "month" in raw_window:
        window = "Monthly"
    elif "day" in raw_window:
        window = "Daily"
    elif raw_window:
        window = raw_window.capitalize()
    else:
        window = ""

    if gn.lower() == "claude and gpt models":
        base = "Claude & GPT"
    elif gn.lower() == "gemini models":
        base = "Gemini"
    else:
        base = re.sub(r"\s+models\b", "", gn, flags=re.IGNORECASE).strip() or gn

    if window:
        return f"{base} {window}"
    return base or "Limit"


def parse_quota_limits(quota_summary: dict[str, Any] | None) -> list[dict[str, Any]]:
    if not quota_summary or not isinstance(quota_summary, dict):
        return []

    limits = []
    groups = quota_summary.get("groups", [])
    if isinstance(groups, list):
        for group in groups:
            if not isinstance(group, dict):
                continue
            group_name = group.get("displayName", "")
            for bucket in group.get("buckets", []):
                if not isinstance(bucket, dict):
                    continue
                rem_frac = bucket.get("remainingFraction")
                if rem_frac is None:
                    continue
                try:
                    rem_frac = float(rem_frac)
                except (ValueError, TypeError):
                    continue

                used_pct = max(0.0, min(1.0, 1.0 - rem_frac))
                # When no quota has been consumed yet (0% used / 100% remaining), the window has
                # not started ticking down, so suppress the placeholder reset timestamp.
                # Once the user begins consuming quota (> 0% used), the authoritative reset timestamp is shown.
                reset_time = str(bucket.get("resetTime") or "") if used_pct > 0.0 else ""
                title = format_bucket_title(group_name, bucket)
                label = bucket.get("displayName") or f"{title} Limit Remaining"

                limits.append({
                    "title": title,
                    "label": label,
                    "percent": round(used_pct, 4),
                    "resetsAt": reset_time,
                })
    return limits


def parse_tier_from_account(data: dict[str, Any]) -> tuple[str, str]:
    project_id = str(data.get("cloudaicompanionProject") or "")

    tier_name = ""
    paid_tier = data.get("paidTier")
    if isinstance(paid_tier, dict) and paid_tier.get("name"):
        tier_name = str(paid_tier["name"])
    elif isinstance(data.get("currentTier"), dict) and data["currentTier"].get("name"):
        tier_name = str(data["currentTier"]["name"])
    elif isinstance(data.get("allowedTiers"), list) and data["allowedTiers"]:
        for t in data["allowedTiers"]:
            if isinstance(t, dict) and t.get("isDefault"):
                tier_name = str(t.get("name") or "")
                break
        if not tier_name and isinstance(data["allowedTiers"][0], dict):
            tier_name = str(data["allowedTiers"][0].get("name") or "")

    return tier_name or FALLBACK_TIER, project_id


def probe_antigravity_backend(access_token: str) -> BackendResult:
    account_data = None
    account_err = None
    for url in (LOAD_CODE_ASSIST_URL, LOAD_CODE_ASSIST_FALLBACK_URL):
        account_data, account_err = post_json(url, {}, access_token, timeout=8)
        if account_data:
            break
        if account_err and account_err.error_type == "unauthenticated":
            return account_err

    if not account_data:
        return account_err or BackendResult(ok=False, error_type="http_error")

    tier_name, project_id = parse_tier_from_account(account_data)

    if not project_id:
        return BackendResult(ok=True, tier_label=tier_name, project_id="", limits=[])

    quota_data, quota_err = post_json(
        RETRIEVE_USER_QUOTA_SUMMARY_URL,
        {"project": project_id},
        access_token,
        timeout=8,
    )
    if not quota_data:
        if quota_err and quota_err.error_type == "unauthenticated":
            return quota_err
        return BackendResult(ok=True, tier_label=tier_name, project_id=project_id, limits=[])

    limits = parse_quota_limits(quota_data)
    return BackendResult(ok=True, tier_label=tier_name, project_id=project_id, limits=limits)


def limit_window_open(entry: dict[str, Any], now: dt.datetime) -> bool:
    raw = str(entry.get("resetsAt") or "").strip()
    if not raw:
        return True
    try:
        resets_at = dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
    except Exception:
        return True
    if resets_at.tzinfo is None:
        resets_at = resets_at.replace(tzinfo=dt.timezone.utc)
    return resets_at > now


def usable_cached_limits(cached: dict[str, Any]) -> list[dict[str, Any]]:
    entries = cached.get("limits")
    if not isinstance(entries, list):
        return []
    now = dt.datetime.now(dt.timezone.utc)
    return [entry for entry in entries if isinstance(entry, dict) and limit_window_open(entry, now)]


def collect_limits(force: bool) -> dict[str, Any]:
    result = {
        "limits": [],
        "tierLabel": "",
        "usageStatusText": "",
        "authHelpText": AUTH_HELP,
        "retryAdvised": False,
    }

    probe_cache = cache_root() / "antigravity-limits.json"
    cached = read_fresh_json(probe_cache, float("inf")) or {}
    fallback = usable_cached_limits(cached)
    cached_tier = str(cached.get("tierLabel") or "")

    token_data, _ = read_keyring_token()

    # 1. No account in keyring (never authenticated or signed out)
    if token_data is None or not isinstance(token_data, dict):
        result["limits"] = fallback
        result["tierLabel"] = declared_plan() or cached_tier or FALLBACK_TIER
        result["usageStatusText"] = "Waiting for auth"
        result["authHelpText"] = AUTH_HELP
        return result

    access_token = str(token_data.get("access_token") or "")
    refresh_token = str(token_data.get("refresh_token") or "")

    if not access_token and not refresh_token:
        result["limits"] = fallback
        result["tierLabel"] = declared_plan() or cached_tier or FALLBACK_TIER
        result["usageStatusText"] = "Waiting for auth"
        result["authHelpText"] = AUTH_HELP
        return result

    # 2. Check if access token is expired; try refreshing if needed
    refreshed = False
    if not token_is_valid(token_data) or not access_token:
        if refresh_token:
            refresh_res = refresh_oauth_token(refresh_token)
            if refresh_res.access_token:
                access_token = refresh_res.access_token
                refreshed = True
            elif refresh_res.error_type == "invalid_grant":
                result["limits"] = fallback
                result["tierLabel"] = declared_plan() or cached_tier or FALLBACK_TIER
                result["usageStatusText"] = "Sign-in expired"
                result["authHelpText"] = (
                    "Antigravity's saved sign-in expired"
                    + (" — showing the last known limits." if fallback else ".")
                    + " Start Antigravity, or run `agy`, to refresh it."
                )
                return result
            elif refresh_res.error_type == "transport":
                result["retryAdvised"] = True
                result["limits"] = fallback
                result["tierLabel"] = declared_plan() or cached_tier or FALLBACK_TIER
                if not fallback:
                    result["usageStatusText"] = "Antigravity limits unavailable"
                    result["authHelpText"] = (
                        "Couldn't reach Google OAuth service. Retrying shortly. Local Antigravity stats are still shown."
                    )
                return result
        else:
            result["limits"] = fallback
            result["tierLabel"] = declared_plan() or cached_tier or FALLBACK_TIER
            result["usageStatusText"] = "Sign-in expired"
            result["authHelpText"] = (
                "Antigravity's saved sign-in expired"
                + (" — showing the last known limits." if fallback else ".")
                + " Start Antigravity, or run `agy`, to refresh it."
            )
            return result

    # 3. Probe cache freshness window
    fetched_at = number(cached.get("fetchedAtMs")) / 1000.0
    if fallback and not force and not refreshed and (time.time() - fetched_at < PROBE_MIN_INTERVAL_SECONDS):
        result["limits"] = fallback
        result["tierLabel"] = cached_tier or declared_plan() or FALLBACK_TIER
        result["usageStatusText"] = ""
        result["authHelpText"] = ""
        return result

    # 4. Probe live backend
    probe = probe_antigravity_backend(access_token)

    # If backend returned 401 Unauthorized, token may have expired server-side: refresh once
    if not probe.ok and probe.error_type == "unauthenticated" and not refreshed and refresh_token:
        refresh_res = refresh_oauth_token(refresh_token)
        if refresh_res.access_token:
            access_token = refresh_res.access_token
            refreshed = True
            probe = probe_antigravity_backend(access_token)

    if probe.ok:
        tier = probe.tier_label or cached_tier or declared_plan() or FALLBACK_TIER
        result["limits"] = probe.limits or []
        result["tierLabel"] = tier
        result["usageStatusText"] = ""
        result["authHelpText"] = ""
        write_json(probe_cache, {
            "fetchedAtMs": round(time.time() * 1000),
            "tierLabel": tier,
            "projectId": probe.project_id,
            "limits": probe.limits or [],
        })
        return result

    # 5. Handle probe failures
    result["tierLabel"] = declared_plan() or cached_tier or FALLBACK_TIER

    if probe.error_type == "unauthenticated":
        result["limits"] = fallback
        result["usageStatusText"] = "Sign-in expired"
        result["authHelpText"] = (
            "Antigravity's saved sign-in expired"
            + (" — showing the last known limits." if fallback else ".")
            + " Start Antigravity, or run `agy`, to refresh it."
        )
        return result

    if probe.error_type == "transport":
        result["retryAdvised"] = True

    if fallback:
        result["limits"] = fallback
    else:
        result["usageStatusText"] = "Antigravity limits unavailable"
        if probe.error_type == "rate_limited":
            retry_text = f" (retry after {probe.retry_after}s)" if probe.retry_after else ""
            result["authHelpText"] = (
                f"Google Cloud Code backend is rate limiting checks right now{retry_text}. "
                "Local Antigravity stats are still shown."
            )
        elif probe.error_type == "transport":
            result["authHelpText"] = (
                "Couldn't reach Google Cloud Code backend. Retrying shortly. Local Antigravity stats are still shown."
            )
        else:
            result["authHelpText"] = (
                probe.help_text or "Google Cloud Code backend returned an error. Local Antigravity stats are still shown."
            )

    return result


# -------------------------------------------------------------------- record


def write_record(record: dict[str, Any]) -> None:
    target_dir = usage_dir()
    record_path = target_dir / f"{AGENT_ID}.json"
    handle_fd, tmp_name = tempfile.mkstemp(dir=target_dir, prefix=f".{AGENT_ID}.", suffix=".tmp")
    tmp = Path(tmp_name)
    try:
        with os.fdopen(handle_fd, "w", encoding="utf-8") as fh:
            json.dump(record, fh, separators=(",", ":"), sort_keys=True)
            fh.write("\n")
        tmp.chmod(0o644)
        tmp.replace(record_path)
    except BaseException:
        tmp.unlink(missing_ok=True)
        raise


def main() -> int:
    parser = argparse.ArgumentParser(description="Print the Antigravity usage record as JSON")
    parser.add_argument("--force", action="store_true", help="rescan transcripts and re-probe limits, ignoring caches")
    parser.add_argument(
        "--limits-only",
        action="store_true",
        help="reuse any recent transcript scan; only the limits probe must be fresh",
    )
    parser.add_argument("--cache-seconds", type=float, default=SCAN_REUSE_SECONDS)
    parser.add_argument("--write", action="store_true", help="also write the record to agents usage state directory")
    args = parser.parse_args()

    app_dir = app_data_dir()
    scan_age = 0 if args.force else (LIMITS_ONLY_REUSE_SECONDS if args.limits_only else args.cache_seconds)
    stats = cached_scan(app_dir, scan_age)
    limits = collect_limits(args.force)

    record = {
        "schemaVersion": 1,
        "id": AGENT_ID,
        "name": AGENT_NAME,
        "icon": "\ue908",
        "iconFont": "omarchy-antigravity",
        "updatedAt": dt.datetime.now(dt.timezone.utc).isoformat(),
        "ready": (
            number(stats.get("totalPrompts")) > 0
            or len(limits["limits"]) > 0
            or number(stats.get("totalSessions")) > 0
            or number(stats.get("activeDays")) > 0
        ),
        "hasLocalStats": (
            number(stats.get("totalPrompts")) > 0
            or number(stats.get("totalSessions")) > 0
            or number(stats.get("activeDays")) > 0
        ),
        "scope": "account",
        "hasPromptStats": number(stats.get("totalPrompts")) > 0,
        "tierLabel": limits["tierLabel"],
        "usageStatusText": limits["usageStatusText"],
        "authHelpText": limits["authHelpText"],
        "limits": limits["limits"],
    }
    if limits.get("retryAdvised"):
        record["retryAdvised"] = True
    record.update(stats)

    output = json.dumps(record, separators=(",", ":"), sort_keys=True)
    if args.write or not sys.stdout.isatty():
        # When invoked by update scripts or background services, always ensure state file is written
        write_record(record)
    print(output)
    return 0


if __name__ == "__main__":
    sys.exit(main())