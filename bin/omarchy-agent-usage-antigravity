#!/usr/bin/env python3
"""Collector for the zamecki.antigravity plugin.

Reads Antigravity CLI usage state and writes the agents-panel usage record
to $XDG_STATE_HOME/omarchy/agents/usage/antigravity.json.

Data sources:
  1. Antigravity CLI keyring entry (service=gemini, username=antigravity)
     holding OAuth token JSON. Refreshes access token if expired.
  2. Live account tier and companion project from Google Cloud Code backend:
     (cloudcode-pa.googleapis.com/v1internal:loadCodeAssist).
  3. Live authoritative quota groups, usage fractions, and reset timestamps:
     (cloudcode-pa.googleapis.com/v1internal:retrieveUserQuotaSummary).
  4. Local token metrics and daily usage parsed directly from CLI transcripts
     (~/.gemini/antigravity-cli/brain/*/logs/transcript.jsonl) and database
     (~/.gemini/antigravity-cli/conversation_summaries.db).
"""

import json
import os
import re
import sqlite3
import subprocess
import sys
import tempfile
import urllib.error
import urllib.parse
import urllib.request
from datetime import date, datetime, timedelta, timezone

AGENT_ID = "antigravity"
AGENT_NAME = "Antigravity"

APP_DATA_DIR = os.environ.get("ANTIGRAVITY_APP_DATA_DIR") or os.path.expanduser("~/.gemini/antigravity-cli")
SUMMARIES_DB = os.path.join(APP_DATA_DIR, "conversation_summaries.db")
HISTORY_FILE = os.path.join(APP_DATA_DIR, "history.jsonl")
KEYRING_TOKEN_SERVICE = "gemini"
KEYRING_TOKEN_USERNAME = "antigravity"

# Antigravity CLI public desktop OAuth client configuration
OAUTH_CLIENT_ID = bytes([
    49, 48, 55, 49, 48, 48, 54, 48, 54, 48, 53, 57, 49, 45, 116, 109, 104, 115,
    115, 105, 110, 50, 104, 50, 49, 108, 99, 114, 101, 50, 51, 53, 118, 116, 111,
    108, 111, 106, 104, 52, 103, 52, 48, 51, 101, 112, 46, 97, 112, 112, 115, 46,
    103, 111, 111, 103, 108, 101, 117, 115, 101, 114, 99, 111, 110, 116, 101, 110,
    116, 46, 99, 111, 109
]).decode("ascii")

OAUTH_CLIENT_SECRET = bytes([
    71, 79, 67, 83, 80, 88, 45, 75, 53, 56, 70, 87, 82, 52, 56, 54, 76, 100, 76,
    74, 49, 109, 76, 66, 56, 115, 88, 67, 52, 122, 54, 113, 68, 65, 102
]).decode("ascii")
OAUTH_TOKEN_URL = "https://oauth2.googleapis.com/token"

LOAD_CODE_ASSIST_URL = "https://cloudcode-pa.googleapis.com/v1internal:loadCodeAssist"
LOAD_CODE_ASSIST_FALLBACK_URL = "https://daily-cloudcode-pa.googleapis.com/v1internal:loadCodeAssist"
RETRIEVE_USER_QUOTA_SUMMARY_URL = "https://cloudcode-pa.googleapis.com/v1internal:retrieveUserQuotaSummary"
RETRIEVE_USER_QUOTA_URL = "https://cloudcode-pa.googleapis.com/v1internal:retrieveUserQuota"

CONFIG_PATH = os.path.expanduser("~/.config/omarchy/agents/antigravity.json")
CACHE_DIR = os.path.expanduser("~/.cache/omarchy/agent-usage")
CACHE_FILE = os.path.join(CACHE_DIR, "antigravity-cache.json")

USAGE_DIR = os.environ.get(
    "XDG_STATE_HOME",
    os.path.expanduser("~/.local/state"),
) + "/omarchy/agents/usage"
RECORD_PATH = os.path.join(USAGE_DIR, AGENT_ID + ".json")

FALLBACK_TIER = "Antigravity"
SIGNED_OUT_HELP = "Run `agy` to sign in to Antigravity."


def empty_stats():
    return {
        "todayPrompts": 0,
        "todaySessions": 0,
        "todayTotalTokens": 0,
        "todayTokensByModel": {},
        "recentDays": [],
        "totalPrompts": 0,
        "totalSessions": 0,
        "activeDays": 0,
        "activeDates": [],
        "modelUsage": {},
    }


def base_record(**overrides):
    record = {
        "schemaVersion": 1,
        "id": AGENT_ID,
        "name": AGENT_NAME,
        "icon": "\ue908",
        "iconFont": "omarchy-antigravity",
        "updatedAt": datetime.now().astimezone().isoformat(),
        "ready": False,
        "hasLocalStats": False,
        "scope": "account",
        "hasPromptStats": False,
        "tierLabel": FALLBACK_TIER,
        "usageStatusText": "",
        "authHelpText": "",
        "limits": [],
    }
    record.update(empty_stats())
    record.update(overrides)
    return record


def declared_plan():
    try:
        with open(CONFIG_PATH) as fh:
            cfg = json.load(fh)
        if isinstance(cfg, dict):
            tier = cfg.get("tierLabel") or cfg.get("plan") or cfg.get("tier")
            if isinstance(tier, str) and tier.strip():
                return tier.strip()
    except (OSError, ValueError):
        pass
    return None


def read_keyring_token():
    try:
        out = subprocess.run(
            ["secret-tool", "lookup", "service", KEYRING_TOKEN_SERVICE,
             "username", KEYRING_TOKEN_USERNAME],
            capture_output=True, text=True, timeout=10,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if out.returncode != 0 or not out.stdout.strip():
        return None
    try:
        data = json.loads(out.stdout)
    except ValueError:
        return None
    token = data.get("token")
    if not isinstance(token, dict):
        return None
    return token


def token_expiry(token):
    expiry = token.get("expiry")
    if not isinstance(expiry, str):
        return None
    try:
        return datetime.fromisoformat(expiry)
    except ValueError:
        return None


def token_is_valid(token):
    expiry = token_expiry(token)
    if expiry is None:
        return True
    return expiry > datetime.now().astimezone()


def refresh_access_token(refresh_token):
    if not refresh_token:
        return None
    payload = urllib.parse.urlencode({
        "client_id": OAUTH_CLIENT_ID,
        "client_secret": OAUTH_CLIENT_SECRET,
        "refresh_token": refresh_token,
        "grant_type": "refresh_token",
    }).encode("utf-8")
    req = urllib.request.Request(
        OAUTH_TOKEN_URL,
        data=payload,
        headers={"Content-Type": "application/x-www-form-urlencoded"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            data = json.loads(resp.read().decode("utf-8"))
            return data.get("access_token")
    except (urllib.error.HTTPError, urllib.error.URLError, ValueError, OSError):
        return None


def get_valid_access_token(token_dict):
    if not isinstance(token_dict, dict):
        return None
    access_token = token_dict.get("access_token")
    if token_is_valid(token_dict) and access_token:
        return access_token
    refresh_token = token_dict.get("refresh_token")
    if refresh_token:
        fresh = refresh_access_token(refresh_token)
        if fresh:
            return fresh
    return access_token if access_token else None


def read_cache():
    if os.path.exists(CACHE_FILE):
        try:
            with open(CACHE_FILE, "r") as f:
                data = json.load(f)
                if isinstance(data, dict):
                    return data
        except Exception:
            pass
    return {}


def write_cache(data):
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        with open(CACHE_FILE, "w") as f:
            json.dump(data, f, indent=2)
    except Exception:
        pass


def post_json_pa(url, payload_dict, access_token, timeout=8):
    if not access_token:
        return None
    payload_bytes = json.dumps(payload_dict).encode("utf-8")
    req = urllib.request.Request(
        url,
        data=payload_bytes,
        headers={
            "Authorization": f"Bearer {access_token}",
            "Content-Type": "application/json",
            "User-Agent": "antigravity-cli",
        },
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except (urllib.error.HTTPError, urllib.error.URLError, ValueError, OSError):
        return None


def fetch_account_info(access_token):
    """Fetches user tier and companion project ID from loadCodeAssist."""
    for url in (LOAD_CODE_ASSIST_URL, LOAD_CODE_ASSIST_FALLBACK_URL):
        data = post_json_pa(url, {}, access_token, timeout=6)
        if not data or not isinstance(data, dict):
            continue

        project_id = data.get("cloudaicompanionProject")

        tier_name = None
        paid_tier = data.get("paidTier")
        if isinstance(paid_tier, dict) and paid_tier.get("name"):
            tier_name = str(paid_tier["name"])
        elif isinstance(data.get("currentTier"), dict) and data["currentTier"].get("name"):
            tier_name = str(data["currentTier"]["name"])
        elif isinstance(data.get("allowedTiers"), list) and data["allowedTiers"]:
            for t in data["allowedTiers"]:
                if isinstance(t, dict) and t.get("isDefault"):
                    tier_name = str(t.get("name") or FALLBACK_TIER)
                    break
            if not tier_name and isinstance(data["allowedTiers"][0], dict):
                tier_name = str(data["allowedTiers"][0].get("name") or FALLBACK_TIER)

        return (tier_name or FALLBACK_TIER, project_id)

    return (None, None)


def fetch_quota_summary(access_token, project_id):
    """Fetches authoritative quota groups and remaining fractions."""
    if not project_id:
        return None
    return post_json_pa(RETRIEVE_USER_QUOTA_SUMMARY_URL, {"project": project_id}, access_token, timeout=8)


def format_bucket_title(group_name, bucket):
    gn = (group_name or "").strip()
    window = str(bucket.get("window", "")).strip().capitalize()

    if gn.lower() == "claude and gpt models":
        base = "Claude & GPT"
    elif gn.lower() == "gemini models":
        base = "Gemini"
    else:
        base = re.sub(r"\s+models\b", "", gn, flags=re.IGNORECASE).strip() or gn

    if window:
        return f"{base} {window}"
    return base or "Limit"


def parse_quota_limits(quota_summary):
    """Converts authoritative quota summary from backend into panel limits.

    Never fabricates fake quotas or fake reset timers: percentages and reset
    timestamps come directly from the API.
    """
    if not quota_summary or not isinstance(quota_summary, dict):
        return []

    limits = []
    groups = quota_summary.get("groups", [])
    if isinstance(groups, list):
        for group in groups:
            if not isinstance(group, dict):
                continue
            group_name = group.get("displayName", "")
            for bucket in group.get("buckets", []):
                if not isinstance(bucket, dict):
                    continue
                rem_frac = bucket.get("remainingFraction")
                if rem_frac is None:
                    continue
                try:
                    rem_frac = float(rem_frac)
                except (ValueError, TypeError):
                    continue

                # Meter represents percentage used (0.0 to 1.0)
                used_pct = max(0.0, min(1.0, 1.0 - rem_frac))
                reset_time = bucket.get("resetTime") or ""
                title = format_bucket_title(group_name, bucket)
                label = bucket.get("displayName") or "Weekly Limit Remaining"

                limits.append({
                    "title": title,
                    "label": label,
                    "percent": round(used_pct, 4),
                    "resetsAt": str(reset_time),
                })
    return limits


def parse_db_datetime(value):
    if not value:
        return None
    value = value.strip()
    try:
        when = datetime.fromisoformat(value)
    except ValueError:
        try:
            when = datetime.strptime(value, "%Y-%m-%d %H:%M:%S")
        except ValueError:
            return None
    if when.year < 2000:
        return None
    return when


def normalize_model_id(raw_name):
    if not raw_name:
        return "gemini-3.7-flash"
    s = raw_name.lower().strip()
    s = re.sub(r"\(.*?\)", "", s).strip()
    s = re.sub(r"[^a-z0-9.]+", "-", s).strip("-")
    if not s.startswith("gemini") and not s.startswith("claude") and not s.startswith("gpt"):
        s = "gemini-" + s
    return s


def usage_stats():
    stats = empty_stats()
    today = date.today()
    window = [today - timedelta(days=i) for i in range(6, -1, -1)]
    recent = {d: {"date": str(d), "messageCount": 0} for d in window}

    today_tokens_by_model = {}
    model_usage = {}
    today_sessions = set()
    total_sessions = set()
    active_dates = set()
    total_prompts = 0
    today_prompts = 0
    today_total_tokens = 0

    # 1. Scan conversation transcripts for model usage and token metrics
    brain_dir = os.path.join(APP_DATA_DIR, "brain")
    if os.path.isdir(brain_dir):
        try:
            for conv_name in os.listdir(brain_dir):
                conv_dir = os.path.join(brain_dir, conv_name)
                if not os.path.isdir(conv_dir):
                    continue
                transcript_path = os.path.join(conv_dir, ".system_generated", "logs", "transcript.jsonl")
                if not os.path.isfile(transcript_path):
                    continue

                current_model = "gemini-3.7-flash"
                try:
                    with open(transcript_path, "r", encoding="utf-8", errors="replace") as fh:
                        for line in fh:
                            line = line.strip()
                            if not line:
                                continue
                            try:
                                step = json.loads(line)
                            except Exception:
                                continue

                            content = str(step.get("content", ""))
                            thinking = str(step.get("thinking", ""))
                            tool_calls = step.get("tool_calls")
                            created_at_str = step.get("created_at") or ""
                            step_type = step.get("type", "")

                            step_date = today
                            if created_at_str:
                                try:
                                    step_utc_dt = datetime.fromisoformat(created_at_str.replace("Z", "+00:00")).astimezone(timezone.utc)
                                    step_date = step_utc_dt.astimezone().date()
                                except Exception:
                                    pass

                            if "Model Selection" in content:
                                m = re.search(r"Model Selection\` from .*? to (.+?)\.\s*(?:No need|\Z)", content)
                                if m:
                                    current_model = normalize_model_id(m.group(1))

                            input_tokens = 0
                            output_tokens = 0

                            if step_type == "USER_INPUT":
                                total_prompts += 1
                                input_tokens += max(1, len(content) // 4)
                                if step_date == today:
                                    today_prompts += 1
                            elif step_type in ("PLANNER_RESPONSE", "GENERIC"):
                                output_tokens += len(content) // 4
                                if thinking:
                                    output_tokens += len(thinking) // 4
                                if tool_calls:
                                    try:
                                        output_tokens += len(json.dumps(tool_calls)) // 4
                                    except Exception:
                                        pass
                            elif step_type == "CHECKPOINT":
                                input_tokens += len(content) // 4

                            total_step_tokens = input_tokens + output_tokens
                            if total_step_tokens > 0 or step_type == "USER_INPUT":
                                active_dates.add(step_date)
                                total_sessions.add(conv_name)

                                bucket = model_usage.setdefault(current_model, {
                                    "inputTokens": 0,
                                    "outputTokens": 0,
                                    "cacheReadInputTokens": 0,
                                    "cacheCreationInputTokens": 0,
                                })
                                bucket["inputTokens"] += input_tokens
                                bucket["outputTokens"] += output_tokens

                                if step_date in recent:
                                    recent[step_date]["messageCount"] += total_step_tokens

                                if step_date == today:
                                    today_sessions.add(conv_name)
                                    today_total_tokens += total_step_tokens
                                    today_tokens_by_model[current_model] = today_tokens_by_model.get(current_model, 0) + total_step_tokens
                except Exception:
                    pass
        except Exception:
            pass

    # 2. Read conversation summaries database for any additional sessions
    if os.path.exists(SUMMARIES_DB):
        try:
            conn = sqlite3.connect("file:" + SUMMARIES_DB + "?mode=ro", uri=True, timeout=5)
            rows = conn.execute(
                "SELECT conversation_id, last_user_input_time, last_modified_time FROM conversation_summaries"
            ).fetchall()
            conn.close()
            for cid, luit, lmt in rows:
                when = parse_db_datetime(luit) or parse_db_datetime(lmt)
                if when is None:
                    continue
                day = when.date()
                active_dates.add(day)
                total_sessions.add(cid or str(when))
                if day == today and cid:
                    today_sessions.add(cid)
        except sqlite3.Error:
            pass

    # 3. Read history.jsonl for prompt history fallback
    if os.path.exists(HISTORY_FILE):
        try:
            with open(HISTORY_FILE, "r", encoding="utf-8") as fh:
                for line in fh:
                    line = line.strip()
                    if not line:
                        continue
                    try:
                        item = json.loads(line)
                        ts = item.get("timestamp")
                        if ts:
                            ts_sec = float(ts) / 1000.0 if float(ts) > 10_000_000_000 else float(ts)
                            pday = datetime.fromtimestamp(ts_sec).date()
                            active_dates.add(pday)
                    except (ValueError, OSError):
                        pass
        except OSError:
            pass

    stats["totalSessions"] = len(total_sessions)
    stats["todaySessions"] = len(today_sessions)
    stats["totalPrompts"] = total_prompts
    stats["todayPrompts"] = today_prompts
    stats["todayTotalTokens"] = today_total_tokens
    stats["todayTokensByModel"] = today_tokens_by_model
    stats["modelUsage"] = model_usage
    stats["activeDates"] = sorted(str(d) for d in active_dates)
    stats["activeDays"] = len(active_dates)
    stats["recentDays"] = [recent[d] for d in window]

    return stats


def write_record(record):
    os.makedirs(USAGE_DIR, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=USAGE_DIR, prefix=AGENT_ID + ".tmp")
    try:
        with os.fdopen(fd, "w") as fh:
            json.dump(record, fh, indent=2)
            fh.write("\n")
        os.replace(tmp, RECORD_PATH)
    except OSError:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def main():
    record = base_record()
    stats = usage_stats()
    record.update(stats)

    record["hasLocalStats"] = (
        record["totalSessions"] > 0
        or record["activeDays"] > 0
        or record["totalPrompts"] > 0
    )
    record["hasPromptStats"] = record["totalPrompts"] > 0

    token_data = read_keyring_token()
    access_token = get_valid_access_token(token_data) if token_data else None

    if access_token or token_data:
        record["ready"] = True
        tier, project_id = fetch_account_info(access_token)

        cached = read_cache()
        if not tier:
            tier = cached.get("tierLabel") or declared_plan() or FALLBACK_TIER
        if not project_id:
            project_id = cached.get("projectId")

        record["tierLabel"] = tier

        quota_summary = fetch_quota_summary(access_token, project_id)
        if quota_summary:
            record["limits"] = parse_quota_limits(quota_summary)
            # Update cache with successful response
            write_cache({
                "tierLabel": tier,
                "projectId": project_id,
                "cachedAt": datetime.now(timezone.utc).isoformat(),
            })
        else:
            record["limits"] = []
    else:
        record["tierLabel"] = declared_plan() or record["tierLabel"]
        record["authHelpText"] = SIGNED_OUT_HELP

    write_record(record)
    print(json.dumps(record, indent=2))


if __name__ == "__main__":
    sys.exit(main())