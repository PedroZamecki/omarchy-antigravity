#!/bin/bash

# zamecki.antigravity: Launch the default coding agent in a terminal.
# Shadows the packaged omarchy-agent to launch the Antigravity CLI (agy) when it
# is the default; every other agent is handed to the packaged command untouched.

packaged="${OMARCHY_PATH:-/usr/share/omarchy}/bin/omarchy-agent"
# Never fall back to a bare name: on PATH that resolves to this wrapper's shim.
if [[ ! -x $packaged ]]; then
  echo "omarchy-agent: $packaged not found" >&2
  exit 1
fi

[[ $(omarchy-default-agent) == "antigravity" ]] || exec "$packaged" "$@"

inline=false
prompt=""

while (($#)); do
  case "$1" in
    --inline) inline=true; shift ;;
    --pick) shift ;;
    --prompt)
      prompt=${2:?--prompt needs a value}
      shift 2
      ;;
    *)
      echo "Unexpected argument: $1" >&2
      echo "To pass a prompt: omarchy agent prompt \"$*\"" >&2
      exit 1
      ;;
  esac
done

[[ $PWD == "$HOME" && -d $HOME/Work ]] && cd "$HOME/Work"

# The Antigravity binary is agy, not antigravity, so the generic presence check
# would report a missing command.
if omarchy-cmd-missing agy; then
  echo "antigravity is not installed. Choose an installed agent with: omarchy default agent <name>" >&2
  exit 1
fi

command=(agy --dangerously-skip-permissions)
[[ -n $prompt ]] && command+=(--prompt-interactive "$prompt")

# Usage refreshes on its own: Service.qml watches agy's history and conversations.
if [[ $inline == "true" ]]; then
  exec "${command[@]}"
else
  exec omarchy-launch-tui --app-id=org.omarchy.agent "${command[@]}"
fi
