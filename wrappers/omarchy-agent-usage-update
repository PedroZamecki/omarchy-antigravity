#!/bin/bash

# zamecki.antigravity: Shadows the packaged omarchy-agent-usage-update so the
# agents panel's refreshes also regenerate the Antigravity record. The packaged
# command still handles every built-in agent; the only extra code run is this
# plugin's own collector.

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
packaged="${OMARCHY_PATH:-/usr/share/omarchy}/bin/omarchy-agent-usage-update"
collector="$here/../bin/omarchy-agent-usage-antigravity"

# The panel names agents by record id, and this plugin's id is the relative path
# that lets the panel find assets/antigravity.svg (see provider_id() in the
# collector), so accept it alongside the plain name.
ours() { [[ $1 == "antigravity" || $1 == */zamecki.antigravity/assets/antigravity ]]; }

args=("$@")
flags=()
run=true
listed=false
named=false

while (($#)); do
  case "$1" in
  --force | --limits-only) flags+=("$1") ;;
  --except)
    ours "${2:-}" && run=false
    shift
    ;;
  *)
    listed=true
    ours "$1" && named=true
    ;;
  esac
  shift
done
[[ $listed == "true" && $named == "false" ]] && run=false

pids=()
if [[ -x $packaged ]]; then
  "$packaged" "${args[@]}" &
  pids+=($!)
fi
if [[ $run == "true" ]]; then
  "$collector" --write "${flags[@]}" >/dev/null &
  pids+=($!)
fi

status=0
for pid in "${pids[@]}"; do
  wait "$pid" || status=1
done
exit $status
