#!/bin/bash

# agy-integration: Set and launch the default coding agent.
# Shadows the packaged omarchy-default-agent to add the Antigravity (agy)
# option; every other call is handed to the packaged command untouched.

here=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
packaged="${OMARCHY_PATH:-/usr/share/omarchy}/bin/omarchy-default-agent"
# Never fall back to a bare name: on PATH that resolves to this wrapper's shim.
if [[ ! -x $packaged ]]; then
  echo "omarchy-default-agent: $packaged not found" >&2
  exit 1
fi

args=("$@")
installing=false
if [[ ${1:-} == "--install" ]]; then
  installing=true
  shift
fi

# The original arguments, --install included, so the packaged install flow for
# other agents survives its hop through the floating terminal.
[[ ${1:-} == "antigravity" ]] || exec "$packaged" "${args[@]}"

agent_package="aqua:google-antigravity/antigravity-cli"
agent_file="$HOME/.config/omarchy/defaults/agent"

if [[ $installing == "false" ]] && ! mise where "$agent_package" &>/dev/null; then
  exec omarchy-launch-floating-terminal-with-presentation omarchy-default-agent --install antigravity
fi

if ! mise use -g "$agent_package"; then
  if [[ $installing == "true" ]]; then
    echo "Could not install Antigravity with mise" >&2
  else
    echo "Could not set Antigravity as the default coding agent" >&2
  fi
  exit 1
fi

mkdir -p "$(dirname "$agent_file")"
printf '%s\n' antigravity >"$agent_file"

if [[ $installing == "true" ]]; then
  printf '\033[2J\033[3J\033[H'
  exec bash "$here/omarchy-agent" --inline
else
  exec bash "$here/omarchy-agent"
fi
